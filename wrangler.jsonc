{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "local-events-ical",
  "main": "src/main.ts",
  "compatibility_date": "2026-10-25",
  "upload_source_maps": true,
  "observability": {
    "enabled": true,
    "logs": {
      "enabled": true,
      "head_sampling_rate": 1
    },
    "traces": {
      "enabled": true,
      "head_sampling_rate": 1
    }
  }
}
